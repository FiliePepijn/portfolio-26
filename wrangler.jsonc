{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio-26",
  "compatibility_date": "2026-05-14",
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "platour.net",
      "custom_domain": true
    }
  ],
  "main": "src/worker.ts",
  "assets": {
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}

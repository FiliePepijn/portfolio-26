{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio-26",
  "compatibility_date": "2026-05-14",
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true
    }
  },
  "routes": [
    {
      "pattern": "platour.net",
      "custom_domain": true
    }
  ],
  "main": "src/worker.ts",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  
  "compatibility_flags": [
    "nodejs_compat"
  ],

  // Worker Previews: `wrangler preview` deploys the current branch as an isolated
  // Preview of this Worker on <branch>-portfolio-26.<subdomain>.workers.dev (noindex).
  // Top-level settings above are production (platour.net). Previews do not inherit
  // secrets — set the JMAP_API_TOKEN / JMAP_MAIL_FROM / CONTACT_EMAIL secrets once with
  // `wrangler preview base-config secret put <NAME>`.
  "preview_urls": true,
  "previews": {}
}
